# Copy to .env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Production site URL (recommended on Vercel). Used for OAuth callbacks.
# NEXT_PUBLIC_SITE_URL=https://luckybronzecoin.com

# Google OAuth — same Client ID / Secret as in Supabase → Auth → Google.
# The server-side flow talks to Google directly so users never need to open
# supabase.co in the browser (fixes ERR_TUNNEL_CONNECTION_FAILED in some regions).
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Crypto payments are verified directly on-chain via public RPC/explorer reads
# (no third-party processor). The defaults below are public endpoints; override
# them with your own (e.g. paid/dedicated RPC) for higher rate limits and
# reliability in production. All optional.
# ETH_RPC_URL=https://eth.llamarpc.com
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# TRON_API_URL=https://api.trongrid.io
# SOL_RPC_URL=https://api.mainnet-beta.solana.com

# FASTEST + most reliable auto-detection of incoming payments to your wallet.
# Recommended for production. When set, the system reads your address's incoming
# transactions directly from these dedicated, address-indexed endpoints.
#   ETHERSCAN_API_KEY — Etherscan V2: ONE key covers Ethereum + BNB Smart Chain
#                       (ETH/BNB native and USDT ERC-20/BEP-20). Get it free at
#                       https://etherscan.io/myapikey
#   TRONGRID_API_KEY  — raises TRON (USDT TRC-20) rate limits. https://www.trongrid.io
# ETHERSCAN_API_KEY=your-etherscan-v2-api-key
# TRONGRID_API_KEY=your-trongrid-api-key

# SMTP — used to send login magic links and contact-form emails. SERVER ONLY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-smtp-account@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Lucky Coin <your-smtp-account@gmail.com>
CONTACT_EMAIL=where-contact-messages-go@example.com

# ---------------------------------------------------------------------
# Stripe — card payments on the /buy page. SERVER ONLY (never exposed to
# the browser: the client only receives the hosted Checkout URL).
#   STRIPE_SECRET_KEY      Dashboard → Developers → API keys
#   STRIPE_WEBHOOK_SECRET  Dashboard → Developers → Webhooks → add an endpoint
#                          at https://YOUR-DOMAIN/api/stripe/webhook and
#                          subscribe to:
#                            checkout.session.completed
#                            checkout.session.async_payment_succeeded
#                            checkout.session.async_payment_failed
#                            checkout.session.expired
#                          then copy the signing secret (whsec_…) here.
#
# Currency: pack prices are listed in USD. Japanese visitors are charged in
# JPY at a fixed book rate of ¥150 per $1 (not a live market rate). Everyone
# else is charged in USD. Optional:
#   STRIPE_CURRENCY        force ONE currency for every buyer regardless of
#                          language, e.g. "jpy" or "usd". Unset = per-language.
#   USD_JPY_RATE           overrides the ¥150 book rate if you need a different
#                          fixed figure. Live FX feeds are not used for JPY.
# Note: Stripe rejects charges under a per-currency floor (¥50 / $0.50), so the
# smallest custom amounts are declined with a clear message.
# Locally you can forward events with:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# STRIPE_CURRENCY=jpy
# USD_JPY_RATE=150

# ---------------------------------------------------------------------------
# LuckyCoinPayments smart contract (optional) — contracts/LuckyCoinPayments.sol
# Deploy one instance per EVM chain and put its address here. When set, the
# checkout offers "Pay with wallet": the order id is encoded into the payment,
# the contract emits PaymentReceived, and the coins are credited automatically
# from that event instead of by matching amounts against a shared address.
# Leave unset to keep the original address-scanning flow — the site works
# either way, so the code can ship before the contract is deployed.
# PAYMENT_CONTRACT_ETHEREUM=0x0000000000000000000000000000000000000000  # chain 1
# PAYMENT_CONTRACT_BSC=0x0000000000000000000000000000000000000000       # chain 56
